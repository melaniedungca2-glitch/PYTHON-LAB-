# FUNCTIONS
def pause():
    input("\nPress Enter to continue...")


def show_header(title):
    print("\n" + "=" * 45)
    print(title.center(45))
    print("=" * 45)


def get_choice(prompt, minimum, maximum):
    while True:
        answer = input(prompt).strip()
        if answer.isdigit():
            answer = int(answer)
            if minimum <= answer <= maximum:
                return answer
        print("Invalid choice. Please enter a number from",
              minimum, "to", maximum, ".")


# PYTHON TUTORIALS
def show_tutorials():
    categories = list(lessons.keys())

    while True:
        show_header("PYTHON TUTORIALS")
        for number, category in enumerate(categories, 1):
            print(number, ".", category)
        print(len(categories) + 1, ". Back to Main Menu")

        choice = get_choice("\nChoose a category: ", 1, len(categories) + 1)
        if choice == len(categories) + 1:
            return

        category = categories[choice - 1]
        lesson_list = lessons[category]

        while True:
            show_header(category)
            for number, lesson in enumerate(lesson_list, 1):
                print(number, ".", lesson[0])
            print(len(lesson_list) + 1, ". Back to Categories")

            lesson_choice = get_choice("\nChoose a lesson: ", 1, len(lesson_list) + 1)
            if lesson_choice == len(lesson_list) + 1:
                break

            lesson_name, lesson_text = lesson_list[lesson_choice - 1]
            show_header(lesson_name)
            print(lesson_text)
            pause()


# QUIZ CENTER
def start_quiz(category):
    questions = quiz_questions[category]
    score = 0

    show_header(category + " QUIZ")
    print("Answer each question using A, B, C, or D.")

    for number, question in enumerate(questions, 1):
        question_text, choices, correct_answer = question
        print("\nQuestion", number, "of", len(questions))
        print(question_text)

        for choice in choices:
            print(choice)

        answer = input("Your answer: ").strip().upper()
        while answer not in ["A", "B", "C", "D"]:
            print("Please enter A, B, C, or D.")
            answer = input("Your answer: ").strip().upper()

        if answer == correct_answer:
            print("Correct answer!")
            score += 1
        else:
            print("Incorrect! Correct answer:", correct_answer)

    total = len(questions)
    quiz_scores.append({
        "name": student_name,
        "category": category,
        "score": score,
        "total": total
    })

    show_header("QUIZ COMPLETED")
    print("Student:", student_name)
    print("Category:", category)
    print("Your Score:", score, "/", total)
    pause()


def show_quiz_center():
    categories = list(quiz_questions.keys())

    while True:
        show_header("QUIZ CENTER")
        for number, category in enumerate(categories, 1):
            print(number, ".", category, "QUIZ")
        print(len(categories) + 1, ". Back to Main Menu")

        choice = get_choice("\nChoose a quiz: ", 1, len(categories) + 1)
        if choice == len(categories) + 1:
            return
        start_quiz(categories[choice - 1])



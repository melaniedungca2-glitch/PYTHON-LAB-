# MY PROGRESS
def show_progress():
    show_header("MY PROGRESS")
    print("Student:", student_name)

    if len(quiz_scores) == 0:
        print("\nNo quiz records yet. Take a quiz first!")
    else:
        print("\nQUIZ RECORDS")
        for record in quiz_scores:
            print(record["category"], ":",
                  record["score"], "/", record["total"])

        total_score = sum(record["score"] for record in quiz_scores)
        total_items = sum(record["total"] for record in quiz_scores)
        print("\nOverall Score:", total_score, "/", total_items)

    print("\nNote: Progress is saved only while this program is running.")
    pause()



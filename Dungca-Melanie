# DEBUGGING CHALLENGES
def show_debugging_challenges():
    while True:
        show_header("DEBUGGING CHALLENGES")
        print("Find the error in each code example.\n")

        for number, item in enumerate(debug_questions, 1):
            print(number, ".")
            print(item[0], "\n")

        print(len(debug_questions) + 1, ". Back to Main Menu")
        choice = get_choice("\nChoose a challenge: ", 1, len(debug_questions) + 1)

        if choice == len(debug_questions) + 1:
            return

        code, answer = debug_questions[choice - 1]
        show_header("DEBUGGING CHALLENGE")
        print("Code with an error:\n")
